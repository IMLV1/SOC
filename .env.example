# Optional Compose overrides. Passwords are generated files, not values in this file.
SOC_DB_PORT=55432
SOC_API_PORT=8000
SOC_WEB_PORT=3000
RELEASE_SHA=local
# Mock is the default. Real Gemini calls require the checked Free Tier project,
# explicit confirmation below, and a key in .local/secrets/gemini_api_key.txt.
SOC_AI_PROVIDER=mock
GEMINI_PROJECT_TIER_CONFIRMED=
GEMINI_SYNTHETIC_DATA_ONLY=true
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
