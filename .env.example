# Optional Compose overrides. Passwords are generated files, not values in this file.
SOC_DB_PORT=55432
SOC_API_PORT=8000
SOC_WEB_PORT=3000
# Optional when a separate local Next.js dev server uses another port.
# Set an exact comma-separated allowlist including both Compose and dev origins.
# SOC_AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4175
RELEASE_SHA=local
# Mock is the only enabled runtime mode. Dify is the planned external AI/RAG
# boundary; live calls stay disabled until the Dify workflow is integrated.
SOC_AI_PROVIDER=mock
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_APP_KEY_FILE=.local/secrets/dify_app_key.txt

# Pin reviewed offline knowledge for newly created runs only.
SOC_KB_ENABLED=false

# Google OIDC transport preparation only; login/callback/account-linking are not enabled.
# OAuth Web Client credentials are unrelated to Dify credentials.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_REDIRECT_URI=
