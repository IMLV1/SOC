# Local environment and secrets (keep sanitized templates)
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
.envrc

# Node.js dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Build output and tool caches
dist/
build/
out/
.next/
.nuxt/
.output/
.vite/
.cache/
.turbo/
*.tsbuildinfo

# Test output (keep test sources and deliberate prototype screenshots)
coverage/
.nyc_output/
playwright-report/
test-results/

# Logs and temporary runtime files
*.log
*.pid
*.pid.lock
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Local editor configuration (keep portable project configuration)
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Dependency lockfiles, source files, docs, tests, .gitkeep files,
# and prototype/screenshots/ are intentionally tracked.
