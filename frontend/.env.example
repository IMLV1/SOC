# Server-only proxy destination; never include credentials. Copy to .env.local.
BACKEND_ORIGIN=http://127.0.0.1:8000
NEXT_TELEMETRY_DISABLED=1

# Public Supabase Auth configuration only. Never put a secret/service_role/DB key here.
# Helpers are prepared; supplying these values does NOT switch SOC authentication yet.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
