# Optional shell configuration for native local execution (not auto-loaded).
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=soc
# Set to the current process role's generated password file. Never put passwords here.
DB_PASSWORD_FILE=
# Only administrator bootstrap reads ROLE_SECRETS_DIR.
ROLE_SECRETS_DIR=
RELEASE_SHA=local
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Explicit loopback HTTP development only; HTTPS deployments must use true.
AUTH_COOKIE_SECURE=false

# Dify is the external AI boundary; a Base URL alone does not enable live calls.
SOC_AI_PROVIDER=mock
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_APP_KEY_FILE=../.local/secrets/dify_app_key.txt

# Offline knowledge release pinning; enable only after reviewed publish.
SOC_KB_ENABLED=false

# Legacy RAG opt-in remains unset; Dify integration needs separate acceptance.
SOC_RAG_REAL_CONFIRMED=

# Google OIDC transport preparation only; login/callback/account-linking are not enabled.
# OAuth Web Client credentials are separate from a Gemini API key.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_FILE=
GOOGLE_OAUTH_REDIRECT_URI=
