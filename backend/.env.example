# Optional shell configuration for native local execution (not auto-loaded).
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=soc
# Set to the current process role's generated password file. Never put passwords here.
DB_PASSWORD_FILE=
# Only administrator bootstrap reads ROLE_SECRETS_DIR.
ROLE_SECRETS_DIR=
RELEASE_SHA=local
AUTH_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Explicit loopback HTTP development only; HTTPS deployments must use true.
AUTH_COOKIE_SECURE=false

# Mock is the default. gemini_free is opt-in for synthetic training fixtures only.
SOC_AI_PROVIDER=mock
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_API_KEY_FILE=../.local/secrets/gemini_api_key.txt
# Set only after checking the selected AI Studio project has Free Tier and no billing.
GEMINI_PROJECT_TIER_CONFIRMED=
GEMINI_SYNTHETIC_DATA_ONLY=true
