# Backend/worker/operator environment template. Not loaded automatically.
# Do not load into the old local stack. See compose.supabase.yaml and the operator guide.
DB_PROVIDER=supabase
# Set values from the selected project's Connect panel; do not guess the region.
DB_PROJECT_REF=
DB_CONNECTION_MODE=direct
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
# One process gets ONE dedicated DB role password file. Never use an API key here.
# API=api_runtime, worker=worker_runtime, evaluator=evaluator_runtime.
DB_PASSWORD_FILE=
# Optional provider CA file mounted read-only; hostname verification is always on.
DB_SSL_CA_FILE=
# Migration owner credentials belong only to a separate operator process.
RELEASE_SHA=
AUTH_COOKIE_SECURE=true
AUTH_ORIGINS=
SOC_AI_PROVIDER=mock
DIFY_API_BASE_URL=https://api.dify.ai/v1
SOC_KB_ENABLED=false
AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Private Fernet key file, generated once; never NEXT_PUBLIC or committed.
SUPABASE_TOKEN_KEY_FILE=
SUPABASE_AUTH_CALLBACK_URL=
